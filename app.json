{
  "expo": {
    "name": "SoundBridge",
    "slug": "soundbridge-acoustic",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSMicrophoneUsageDescription": "SoundBridge uses the microphone to receive acoustic soundwave broadcasts."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0A0D14"
      },
      "package": "com.soundbridge.acoustic",
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ]
    },
    "platforms": ["ios", "android", "web"],
    "web": {
      "bundler": "metro"
    }
  }
}
